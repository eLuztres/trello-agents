# API key: https://trello.com/power-ups/admin → New Power-Up → API key
TRELLO_API_KEY=
# Token: open https://trello.com/1/authorize?expiration=never&scope=read,write&response_type=token&key=<YOUR_KEY>
TRELLO_TOKEN=

# Speech-to-text on the review page (npm run videos). The same key as the shops.
OPENAI_API_KEY=
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
