{
  "name": "trello-agents",
  "private": true,
  "type": "module",
  "description": "Runs a Claude Code agent for each Trello list: plan in Planning, build in To Do and Doing, review and docs in Testing.",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning --env-file=.env src/index.ts",
    "lists": "node --disable-warning=ExperimentalWarning --env-file=.env src/lists.ts",
    "status": "node --disable-warning=ExperimentalWarning src/status.ts",
    "lint": "tsc --noEmit",
    "test": "node --test tests/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2"
  }
}
